# Backend (Spring Boot) base URL.
# A physical device can't reach "localhost": use your computer's LAN IP, e.g. http://192.168.1.20:8081
# Defaults when unset: iOS simulator -> http://localhost:8081, Android emulator -> http://10.0.2.2:8081
EXPO_PUBLIC_API_URL=http://localhost:8081

# Public web app origin; encoded into the result QR code so players without the app can open it
EXPO_PUBLIC_WEB_URL=https://match-minton.vercel.app
